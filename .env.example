# Database
MSSQL_SA_PASSWORD=your_password_here
DATABASE_AUTO_MIGRATE=true
DATABASE_CONNECTION=Server=mssql;Database=CinemaDatabase;User Id=sa;Password=your_password_here;TrustServerCertificate=true
HANGFIRE_CONNECTION=Server=mssql;Database=CinemaDatabase;User Id=sa;Password=your_password_here;TrustServerCertificate=true

# Redis
REDIS_CONNECTION=host.docker.internal:6379,password=change_me_redis_password,abortConnect=false

# Frontend / auth
FRONTEND_BASE_URL=https://galaxiadcine.online
JWT_KEY=change_me_long_random_jwt_key
JWT_ISS=https://api.galaxiadcine.online
JWT_AUD=https://api.galaxiadcine.online
AES_256_KEY=change_me_64_hex_chars
AES_256_IV=change_me_32_hex_chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
JINA_API_KEY=your_jina_api_key_here
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_COLLECTION=cinema_movies
QDRANT_API_KEY=your_qdrant_api_key_here

# Tavily (business research / AI admin research). Required by docker-compose for the AI service.
# Only the API key is required (same key as Tavily Search/Extract/Crawl/Research playground).
# Get a key at https://app.tavily.com — REST API base: https://api.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
# Optional. Leave empty. Code already defaults to Tavily remote MCP:
#   https://mcp.tavily.com/mcp/?tavilyApiKey=<TAVILY_API_KEY>
# (see https://docs.tavily.com/documentation/mcp). If MCP fails, service falls back to
# POST https://api.tavily.com/search (same as the Search API playground / tavily-python).
TAVILY_MCP_URL=
BUSINESS_RESEARCH_MAX_RESULTS=5
BUSINESS_RESEARCH_TIMEOUT_SECONDS=45

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.galaxiadcine.online/api/v1/booking/vnpay-callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_CALLBACK_URL=https://api.galaxiadcine.online/api/v1/IdentityAccess/google-callback-web
GOOGLE_MOBILE_CALLBACK_URL=https://api.galaxiadcine.online/api/v1/IdentityAccess/google-callback-mobile

# Required in production. Put the BCrypt hash for admin/manager seed accounts here.
PRODUCTION_MANAGER_PASSWORD_HASH=
