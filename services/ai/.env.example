# Environment: development | production
ENVIRONMENT=development

# Embedding backend: local | cloud
EMBEDDING_BACKEND=local

# Local Embedding Settings (BAAI/bge-m3 runs inside the container)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=768

# Cloud Embedding Settings (Jina AI - used when EMBEDDING_BACKEND=cloud)
JINA_API_KEY=your_jina_api_key_here

# Google Gemini API Key (for movie embedding generation, not for chat)
GOOGLE_API_KEY=your_google_api_key_here

# Server settings
HOST=0.0.0.0
PORT=8000

# Qdrant Vector DB Settings
# localhost = run AI on host; docker-compose.yml overrides to http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cinema_movies

# DeepSeek LLM Settings (For chat, intent classification & safety guard filter)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Redis config for chatbot session memory (same connection string as C# backend)
REDIS_CONNECTION=localhost:6379

# Backend C# API base URL for agent tool retrieval
BACKEND_API_URL=http://localhost:8080/api/v1

# Business research. Only TAVILY_API_KEY is required (same key as Tavily Search playground).
# Get a key at https://app.tavily.com — REST: https://api.tavily.com/search
TAVILY_API_KEY=your_tavily_api_key_here
# Optional. Leave empty — defaults to https://mcp.tavily.com/mcp/?tavilyApiKey=<key>
# (docs: https://docs.tavily.com/documentation/mcp). MCP fail → HTTP Search fallback.
TAVILY_MCP_URL=
BUSINESS_RESEARCH_MAX_RESULTS=5
BUSINESS_RESEARCH_TIMEOUT_SECONDS=45
