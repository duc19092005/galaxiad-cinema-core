# Test Environment Variables (Fully Isolated, No Production Impact)
ASPNETCORE_ENVIRONMENT=Testing
DATABASE_AUTO_MIGRATE=true
Database__AutoMigrate=true
ConnectionStrings__DatabaseConnection=Server=mssql;Database=CinemaTestDb;User Id=sa;Password=Test_Cinema_Password123!;TrustServerCertificate=True;
ConnectionStrings__HangfireConnection=Server=mssql;Database=CinemaTestDb;User Id=sa;Password=Test_Cinema_Password123!;TrustServerCertificate=True;
ConnectionStrings__RedisConnection=redis:6379,abortConnect=false
AiService__BaseUrl=http://ai-http:8000
AiService__GrpcUrl=http://ai-grpc:50051

# JWT & Crypto Test Keys
JWT_KEY=TestSuperSecretKeyForJwtAuthenticationTestingOnly1234567890!
JWT_ISS=CinemaTest
JWT_AUD=CinemaTest
AES_256_KEY=Test1234567890123456789012345678
AES_256_IV=Test123456789012

# VNPay Mock Test Config
VNPay__TmnCode=TESTTMN
VNPay__HashSecret=TESTHASHSECRET1234567890ABCDEF
VNPay__PayUrl=http://vnpay-simulator:8080/vnpay/pay
VNPay__ReturnUrl=http://localhost:8080/api/v1/Booking/vnpay-callback

# Background Jobs Switch (explicit invocation in integration tests)
BackgroundJobs__Enabled=false

# MSSQL Container Config
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Test_Cinema_Password123!

# Qdrant & Redis
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cinema_test_movies
REDIS_HOST=redis
REDIS_PORT=6379
