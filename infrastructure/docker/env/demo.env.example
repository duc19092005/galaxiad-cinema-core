# Demo Environment Variables
ASPNETCORE_ENVIRONMENT=Development
DATABASE_AUTO_MIGRATE=true
Database__AutoMigrate=true
ConnectionStrings__DatabaseConnection=Server=mssql;Database=CinemaDemoDb;User Id=sa;Password=Demo_Cinema_Password123!;TrustServerCertificate=True;
ConnectionStrings__HangfireConnection=Server=mssql;Database=CinemaDemoDb;User Id=sa;Password=Demo_Cinema_Password123!;TrustServerCertificate=True;
ConnectionStrings__RedisConnection=redis:6379,abortConnect=false
AiService__BaseUrl=http://ai-http:8000
AiService__GrpcUrl=http://ai-grpc:50051

# JWT & Crypto Demo Keys
JWT_KEY=DemoSuperSecretKeyForJwtAuthenticationTestingOnly1234567890!
JWT_ISS=CinemaDemo
JWT_AUD=CinemaDemo
AES_256_KEY=Demo1234567890123456789012345678
AES_256_IV=Demo123456789012

# VNPay Mock Demo Config
VNPay__TmnCode=DEMOTMN
VNPay__HashSecret=DEMOHASHSECRET1234567890ABCDEF
VNPay__PayUrl=http://vnpay-simulator:8080/vnpay/pay
VNPay__ReturnUrl=http://localhost:8080/api/v1/Booking/vnpay-callback

# Background Jobs Switch (enabled in demo)
BackgroundJobs__Enabled=true

# MSSQL Container Config
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Demo_Cinema_Password123!

# Qdrant & Redis
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cinema_demo_movies
REDIS_HOST=redis
REDIS_PORT=6379
