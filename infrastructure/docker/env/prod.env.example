# Production Environment Variables (Template)
ASPNETCORE_ENVIRONMENT=Production
DATABASE_AUTO_MIGRATE=true
ConnectionStrings__DatabaseConnection=Server=mssql;Database=CinemaProdDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;
ConnectionStrings__HangfireConnection=Server=mssql;Database=CinemaProdDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;
ConnectionStrings__RedisConnection=redis:6379,abortConnect=false

AllowedOrigins__0=https://galaxiadcine.online
AllowedOrigins__1=https://www.galaxiadcine.online
FrontendBaseUrl=https://galaxiadcine.online

JWT_KEY=ChangeThisInProductionToAStrongRandomSecretKey32BytesLong!
JWT_ISS=https://api.galaxiadcine.online
JWT_AUD=https://galaxiadcine.online
AES_256_KEY=ChangeThisInProduction32BytesLong!
AES_256_IV=ChangeThis16Byte!

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VNPay Production
VNPay__TmnCode=
VNPay__HashSecret=
VNPay__PayUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__ReturnUrl=https://api.galaxiadcine.online/api/v1/Booking/vnpay-callback

# Google OAuth
Google__ClientId=
Google__ClientSecret=
Google__WebCallbackUrl=https://api.galaxiadcine.online/api/v1/IdentityAccess/google-callback-web
Google__MobileCallbackUrl=https://api.galaxiadcine.online/api/v1/IdentityAccess/google-callback-mobile

# TMDB
Tmdb__ApiKey=
Tmdb__ImageBaseUrl=https://image.tmdb.org/t/p/w185

SeedAccounts__ProductionManagerPasswordHash=

# AI Cloud Config
JINA_API_KEY=
QDRANT_URL=
QDRANT_COLLECTION=cinema_movies
QDRANT_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
